{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts", ".agents/skills/**/*.ts"]
}
